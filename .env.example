# tri-coach environment template (PROJECT_BRIEF §14).
# Secrets only via environment variables; never commit keys.
# Copy to .env (repo root for Compose, backend/.env for local `uv run`) and fill in.

# --- Application -----------------------------------------------------------
# Human-facing application name (default is fine).
APP_NAME=tri-coach
# Deployment environment: dev | staging | prod.
ENVIRONMENT=dev
# Debug mode switch; keep False outside local development.
DEBUG=false
# Owner timezone (§14: metric units, Europe/Madrid).
TIMEZONE=Europe/Madrid

# --- Infrastructure ---------------------------------------------------------
# Postgres password used by Compose interpolation (required, no default).
POSTGRES_PASSWORD=CHANGE_ME
# Async Postgres DSN (pgvector-capable Postgres 16, §6/§8).
DATABASE_URL=postgresql+asyncpg://tri_coach:CHANGE_ME@localhost:5432/tri_coach
# Redis broker/result backend for Celery.
REDIS_URL=redis://localhost:6379/0

# --- Secrets (leave empty in the template; fill via environment only) -------
# Intervals.icu API key — the sole ingestion source (§5.1).
INTERVALS_API_KEY=
# Intervals.icu athlete ID (0 = the API key's owner; default 0).
INTERVALS_ATHLETE_ID=0
# Intervals.icu API v1 base URL (verified: official API cookbook).
INTERVALS_BASE_URL=https://intervals.icu/api/v1
# Retries after the initial attempt for 429/5xx (rate limits: 30/s burst, 132/10s).
INTERVALS_MAX_RETRIES=3
# Exponential backoff factor: sleep = factor * 2**attempt seconds between retries.
INTERVALS_BACKOFF_FACTOR=0.5
# Minimum interval between client calls during sync (0.1s => at most 10 req/s; 0 disables).
INTERVALS_MIN_REQUEST_INTERVAL_S=0.1

# --- Athlete thresholds (owner-supplied configuration; brief §14, §5.1) -----
# Editable configuration for the deterministic load engine (§7.1). The editing
# surface is Intervals.icu: run `python -m app.ingest.thresholds` (backend dir)
# to fetch current values and print ready-to-paste lines. These are NEVER
# authoritative computed metrics (§5.1) — engine-computed values take
# precedence and Intervals values are cross-check only. Leave a key empty when
# the value is unknown; a missing value must never be silently defaulted.
# Endpoint payload shapes live-verified 2026-10-02.
# Functional threshold power, watts (sport-settings "Ride" entry "ftp").
ATHLETE_FTP_W=
# Lactate threshold heart rate, bpm (sport-settings "lthr").
ATHLETE_LTHR_BPM=
# Maximum heart rate, bpm (sport-settings "max_hr").
ATHLETE_HR_MAX_BPM=
# Resting heart rate, bpm (athlete profile "icu_resting_hr").
ATHLETE_HR_REST_BPM=
# Swim critical-swim-speed (CSS), m/s (sport-settings "Swim" entry
# "threshold_pace"; live-verified 0.8333333 m/s on 2026-10-02).
ATHLETE_CSS_SPEED_MPS=
# Run threshold speed, m/s (sport-settings "Run" entry "threshold_pace";
# null for this owner — a known, explicitly reported gap).
ATHLETE_THRESHOLD_RUN_SPEED_MPS=
# Body weight, kg (athlete profile "weight"; null for this owner).
ATHLETE_WEIGHT_KG=

# Raw FIT file storage (ING-6, brief §5.2): local root where downloaded raw
# FIT files are archived so the engine can be re-run when formulas change.
# Relative to the backend working directory; inside Compose the fit-data
# volume is mounted at /data/fit and INGEST_STORAGE_ROOT is set there.
INGEST_STORAGE_ROOT=data/fit
# Set to false to disable raw FIT archiving (activities keep raw_file_path NULL).
INGEST_STORAGE_ENABLED=true

# Twilio WhatsApp credentials (§5.1).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sending number in WhatsApp format, e.g. whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=
# Comma-separated allowlist of permitted WhatsApp numbers.
TWILIO_WHATSAPP_ALLOWLIST=

# --- LLM providers (switchable per §6; both optional placeholders) ----------
# Anthropic API key (if Anthropic is the chosen provider, §15).
ANTHROPIC_API_KEY=
# OpenAI API key (if OpenAI is the chosen provider, §15).
OPENAI_API_KEY=

# --- Observability -----------------------------------------------------------
# Langfuse tracing credentials.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse host URL, e.g. https://cloud.langfuse.com.
LANGFUSE_HOST=

# --- Logging / versioning -----------------------------------------------------
# Log level for the API and worker.
LOG_LEVEL=INFO
# Version stamped on every persisted engine output (§6).
ENGINE_VERSION=0.1.0

# --- Engine constants (LOAD-11; brief §7, §14) ------------------------------
# Every constant of the deterministic load engine, sourced and configurable.
# Defaults equal today's effective engine values; the pure engine functions
# keep the same values as their documented fallback. The read layer passes
# them into the engine — the engine never reads settings (§6).
# Performance Manager time constants (Allen & Coggan, "Training and Racing
# with a Power Meter", Performance Manager Chart).
ENGINE_TAU_CTL_DAYS=42
ENGINE_TAU_ATL_DAYS=7
# Minimum PMC history in days before the series is flagged confident.
# OWNER CHOICE: ~2 chronic time constants (2 x 42 d); below it CTL is
# seed-dominated (§7.2 low-confidence flag).
ENGINE_MIN_HISTORY_DAYS=90
# ACWR EWMA time constants (Williams, Trewartha, Cross, Kemp & Stokes 2017).
ENGINE_ACWR_TAU_ACUTE_DAYS=7
ENGINE_ACWR_TAU_CHRONIC_DAYS=28
# Normalized Power rolling window in samples (Coggan NP definition: 30 s on
# the 1 Hz per-second power stream) and the minimum fraction of valid
# samples a window needs to qualify (OWNER CHOICE: strict 1.0 — only fully
# complete windows count; relax explicitly for gap-heavy streams).
ENGINE_NP_WINDOW_SAMPLES=30
ENGINE_MIN_VALID_FRACTION=1.0
# Banister TRIMP exponent coefficients a * e^(b * dHRr) (Banister 1991,
# "Modeling elite athletic performance"): male 0.64/1.92, female 0.86/1.67.
ENGINE_TRIMP_MALE_A=0.64
ENGINE_TRIMP_MALE_B=1.92
ENGINE_TRIMP_FEMALE_A=0.86
ENGINE_TRIMP_FEMALE_B=1.67
# Which sexed coefficient set the read layer selects (OWNER CHOICE; the
# shipped default "male" is today's effective value).
ENGINE_TRIMP_SEX=male
# hrTSS reference duration in minutes (Coggan hrTSS convention: one hour at
# LTHR = 100 hrTSS).
ENGINE_TRIMP_REFERENCE_MINUTES=60
# Strength sRPE TSS-equivalent factor (Foster et al. 2001 session-RPE).
# OWNER CHOICE (2026-10-05): equivalent-effort anchor — one hour at RPE 7
# (Foster AU = 7 x 60 = 420) is treated as equivalent to one hour at
# threshold (100 TSS), so the factor is 100 / 420 = 0.2380952380952381
# (~0.2381). A documented owner decision, NOT a literature constant. It
# makes the owner's real 40.3-minute RPE-7 gym session (282.1 AU) ~67
# TSS-equivalent — comparable to a one-hour ride (~60 TSS) — where the
# earlier raw-AU value 1.0 made it 282 and dwarfed every ride. The
# hrTSS-implied anchor (~0.024, measured by app.tools.calibrate_srpe) was
# explicitly rejected: it reproduces heart rate's undervaluation of
# strength work.
ENGINE_SRPE_TSS_EQUIVALENT_FACTOR=0.2380952380952381
# Banister impulse-response time constants (Banister 1991; Morton,
# Fitz-Clarke & Banister 1990): fitness tau1, fatigue tau2, days.
ENGINE_BANISTER_TAU1_DAYS=42
ENGINE_BANISTER_TAU2_DAYS=7
# Minimum performance markers before a Banister fit is attempted.
# OWNER CHOICE: 10 = 2 x 5 free parameters (p0, k1, k2, tau1, tau2).
ENGINE_BANISTER_MIN_MARKERS=10
# Intervals.icu PMC cross-check tolerances (§12.3; cross-check only, §5.1):
# a day passes when the relative deviation is within ±10% OR the absolute
# deviation within ±0.5 CTL/ATL points — OWNER-AGREED hybrid rule (relative
# alone is unusable for a decaying series near zero); bounds inclusive.
ENGINE_CROSS_CHECK_RELATIVE_TOLERANCE=0.10
ENGINE_CROSS_CHECK_ABSOLUTE_TOLERANCE=0.5
# Their-side revision-detection threshold in CTL/ATL points. OWNER CHOICE:
# above the float noise of exact-decay days, below the measured real-data
# Intervals revisions (0.4462 ATL, 0.4982 CTL).
ENGINE_CROSS_CHECK_REVISION_THRESHOLD=0.25
